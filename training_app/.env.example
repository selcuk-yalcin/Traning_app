# Traning_app — presentation engine (copy to .env and fill values)
# Never commit .env — see .gitignore

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
APP_ENV=development
# Shared secret for validating tokens/callbacks from admin_pan (if applicable)
ADMIN_SHARED_SECRET=
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins for admin_pan (Vite/React) calling the engine API
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# LLM router (use one or many; orchestrator picks by tier)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenRouter metadata (some setups require these)
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_SITE_URL=https://localhost

# Default models per tier (OpenRouter-style IDs when OPENROUTER_API_KEY is set)
MODEL_TIER_STANDARD=openai/gpt-4o-mini
MODEL_TIER_PRO=openai/gpt-4o
MODEL_TIER_ULTRA=anthropic/claude-sonnet-4

# -----------------------------------------------------------------------------
# Vision / multimodal (reading images & PDF pages as images)
# -----------------------------------------------------------------------------
# OpenRouter: multimodal chat model with image input
VISION_MODEL_OPENAI=google/gemini-2.5-flash

# -----------------------------------------------------------------------------
# Image generation (diagram covers, AI slides)
# -----------------------------------------------------------------------------
# Native OpenAI only (used when OPENROUTER_API_KEY is empty):
OPENAI_IMAGE_MODEL=dall-e-3
# OpenRouter chat+image (used when OPENROUTER_API_KEY is set):
#   standard → google/gemini-2.5-flash-image
#   pro      → google/gemini-3.1-flash-image-preview
#   ultra    → black-forest-labs/flux.2-pro
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Google Imagen / Vertex — optional
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# VERTEX_IMAGEN_MODEL=

# -----------------------------------------------------------------------------
# Stock photography
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Text-to-speech (pick one primary; optional extras)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Default ElevenLabs voice id (override per request with tts_voice_id)
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Native OpenAI TTS (when OPENROUTER_API_KEY is empty):
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=tts-1
# OpenRouter TTS (POST /audio/speech — when OPENROUTER_API_KEY is set):
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# -----------------------------------------------------------------------------
# MongoDB (optional — job status, deck JSON snapshots, idempotency keys)
# -----------------------------------------------------------------------------
# Single URI; use one database for this service (not shared RCA taxonomy DB names)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=traning_app
MONGODB_DB=presentation_engine
MONGODB_COLLECTION_JOBS=generation_jobs
MONGODB_COLLECTION_DECKS=decks

# -----------------------------------------------------------------------------
# Redis (recommended — Celery/RQ/arq broker, caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# PostgreSQL (optional — only if you attach analytics or admin shared DB)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traning_app

# -----------------------------------------------------------------------------
# Object storage — uploads, generated pptx/mp4, public URLs
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=
# CDN or bucket website base for client-facing links
S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# OCR / scanned PDF (optional cloud APIs)
# -----------------------------------------------------------------------------
# AWS_TEXTRACT_REGION=
# GOOGLE_DOCUMENT_AI_LOCATION=
# GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# -----------------------------------------------------------------------------
# Research agent (optional web search)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Media pipeline — slide audio sync (MP4 export)
# POST /presentations/generate: use_tts=true, use_video=true (requires ffmpeg on PATH)
# -----------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
# STORAGE_EXPORTS_DIR=storage/exports

# -----------------------------------------------------------------------------
# Safety / cost caps (engine defaults; admin_pan may override per tenant)
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_IMAGES_PER_JOB=20
MAX_VISION_CALLS_PER_JOB=30
MAX_LLM_TOKENS_PER_JOB=200000
